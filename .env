# Переменные docker compose (читается автоматически, лежит рядом с docker-compose.yml).
# Значения по умолчанию — локальные; для выкладки смените JWT_SECRET и пароль базы.

# Порт сайта на хосте: http://localhost:8080. Контейнер nginx слушает 80.
WEB_PORT=8080

# Postgres (контейнер из этого же compose) и секрет подписи JWT.
POSTGRES_DB=text_game_db
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
JWT_SECRET=developer-secret-key-32chars-minimum

# Пин образа API: единое место правки для docker-compose.yml и CI
# (.github/workflows/ci.yml). Бамп версии бэкенда — правка этой строки.
# Значение без кавычек и хвостовых комментариев: CI парсит его плоским sed.
TEXTGAME_API_IMAGE=ka666ah/text-game-api:1.2.0

# Подсеть compose-сети: бэкенд доверяет ей как источнику X-Forwarded-For/Proto
# (ForwardedHeaders:KnownNetworks). После смены нужен docker compose down.
TEXTGAME_SUBNET=10.10.0.0/16

# Схема, которую nginx сообщает бэкенду в X-Forwarded-Proto. Внутри контейнера
# nginx всегда слушает http, поэтому $scheme не годится: за прокси с TLS нужно
# https, иначе refresh-кука уходит без флага Secure.
# Локальная отладка по http://localhost:8080 — поставьте http.
TEXTGAME_FORWARDED_PROTO=https
