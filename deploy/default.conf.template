# TextGame: статика SPA и прокси /api на бэкенд.
# Подставь домен, путь до собранного dist и адрес API.

server {
    listen 80;
    server_name game.example.com;

    root /usr/share/nginx/html;
    index index.html;

    # Приложение отправляет только JSON, тела больше мегабайта не бывает.
    client_max_body_size 1m;

    # Заголовки заданы один раз на уровне server и работают везде.
    # Внимание: любой add_header внутри location отменяет все унаследованные
    # add_header целиком, поэтому ниже в location их нет — только expires.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    # Имена файлов в assets содержат хеш, их можно кэшировать навсегда.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # index.html кэшировать нельзя: в нём ссылки на новые хеши сборки.
    location = /index.html {
        expires -1;
        try_files $uri =404;
    }

    # Прокси. Слеш на конце proxy_pass срезает префикс: бэкенд ждёт /auth/me,
    # а не /api/auth/me. Без слеша запросы уйдут с префиксом и получат 404.
    location /api/ {
        proxy_pass http://text-game-api:8080/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # Обязательно: отпечаток refresh-токена считается по IP, а Secure у куки
        # выставляется по схеме. Без этих заголовков за прокси игроков
        # разлогинивает, а куки могут уйти без Secure.
        # На стороне API IP этого nginx должен быть в ForwardedHeaders:KnownNetworks.
        # Схему НЕ берём из $scheme: когда TLS терминирует внешний прокси, здесь
        # всегда http, и заголовок перетёр бы https от него. Передаём то, что
        # пришло, а пустой заголовок nginx просто не отправляет.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        proxy_read_timeout 60s;
    }

    # /game, /saves, /sessions — клиентские маршруты. Без fallback на
    # index.html F5 на любом из них даёт 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
